{
  "name": "finanzplaner-acceptance",
  "dns": true,
  "services": [
    {
      "id": "app",
      "image": "localhost/finanzplaner:1.2.0-rc.1",
      "entrypoint": ["/usr/local/bin/finanzplaner-entrypoint"],
      "command": ["serve"],
      "args": [],
      "env": {
        "ENVIRONMENT": "production",
        "DATABASE_PATH": "/data/finanzplaner.db",
        "BACKUP_DIR": "/backups",
        "COOKIE_SECURE": "false",
        "TRUSTED_HOSTS": "finanzplaner-acceptance.home.arpa,localhost,127.0.0.1",
        "TZ": "Europe/Berlin",
        "LOG_LEVEL": "INFO"
      },
      "secrets": {
        "SESSION_SECRET": "SESSION_SECRET",
        "SETUP_TOKEN": "SETUP_TOKEN"
      },
      "cpus": 1,
      "memoryMB": 512,
      "rootfsGB": 1,
      "volumes": [
        {"name": "finanzdaten-acceptance", "destination": "/data"},
        {"name": "finanzbackups-acceptance", "destination": "/backups"}
      ],
      "healthCheck": ["curl", "--fail", "--silent", "http://127.0.0.1:8080/health/ready"],
      "healthTimeoutSeconds": 90,
      "livenessCheck": ["curl", "--fail", "--silent", "http://127.0.0.1:8080/health/live"],
      "livenessIntervalSeconds": 15,
      "livenessFailThreshold": 3,
      "restartPolicy": "always"
    },
    {
      "id": "backup",
      "image": "localhost/finanzplaner:1.2.0-rc.1",
      "entrypoint": ["/usr/local/bin/finanzplaner-entrypoint"],
      "command": ["backup"],
      "args": [],
      "env": {
        "ENVIRONMENT": "production",
        "DATABASE_PATH": "/data/finanzplaner.db",
        "BACKUP_DIR": "/backups",
        "TZ": "Europe/Berlin"
      },
      "secrets": {
        "SESSION_SECRET": "SESSION_SECRET",
        "SETUP_TOKEN": "SETUP_TOKEN"
      },
      "cpus": 1,
      "memoryMB": 256,
      "rootfsGB": 1,
      "volumes": [
        {"name": "finanzdaten-acceptance", "destination": "/data"},
        {"name": "finanzbackups-acceptance", "destination": "/backups"}
      ],
      "schedule": "15 3 * * *",
      "restartPolicy": "no"
    }
  ],
  "ingress": {
    "hostPort": 18081,
    "bindAddress": "127.0.0.1",
    "routes": [
      {
        "host": "finanzplaner-acceptance.home.arpa",
        "service": "app",
        "port": 8080
      }
    ]
  }
}
